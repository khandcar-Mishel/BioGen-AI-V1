# Backend sign-in (copy to .env, fill in, then push it to Modal):
#   modal secret create biogen-secrets --from-dotenv .env --force
#   modal deploy compute/modal/biogen_modal_app.py
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=choose-a-long-password
# At least 32 characters; signs the session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Session length in hours (default 12)
JWT_TTL_HOURS=12

BIOGEN_API_KEY=


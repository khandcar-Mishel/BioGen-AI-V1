# The backend the app talks to: your Modal gateway URL, printed by `modal deploy`
#   https://<workspace>--biogen-rfdiffusion-api.modal.run
# It is not a secret (sign-in protects it), but Vite reads it when the app is BUILT:
#   local:  put it in frontend/.env and restart `npm run dev`
#   Vercel: Project Settings -> Environment Variables, then redeploy
VITE_BACKEND_URL=

# Contact form on the About page. Get a free access key at https://web3forms.com by entering the inbox that
# should receive messages (mishel.bioinfo@gmail.com); the key is emailed there. It is public by design.
# Leave empty to fall back to a mailto: draft. Set it in frontend/.env locally and in Vercel env vars, then rebuild.
VITE_WEB3FORMS_KEY=
